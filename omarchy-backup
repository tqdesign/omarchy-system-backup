class UI:
    def __init__(self, scr, cfg, allow_loop=False):
        self.scr = scr
        self.cfg = cfg
        self.allow_loop = allow_loop
        self.opened_backup = None  # mapper name when a backup drive was unlocked here
        curses.curs_set(0)
        curses.use_default_colors()
        for pair, color in enumerate((curses.COLOR_CYAN, curses.COLOR_GREEN, curses.COLOR_YELLOW, curses.COLOR_RED), 1):
            curses.init_pair(pair, color, -1)
        self.accent = curses.color_pair(1) | curses.A_BOLD
        self.good = curses.color_pair(2)
        self.warn = curses.color_pair(3)
        self.bad = curses.color_pair(4)

    @property
    def dest(self):
        return Path(self.cfg["dest"])

    # --- drawing primitives ---

    def put(self, y, x, text, attr=0):
        h, w = self.scr.getmaxyx()
        if 0 <= y < h and x < w - 1:
            self.scr.addnstr(y, x, text, max(0, w - 1 - x), attr)

    def frame(self, title, header=()):
        self.scr.erase()
        self.put(0, 2, "Omarchy System Backup", self.accent)
        self.put(1, 2, title, curses.A_BOLD)
        y = 3
        for text, attr in header:
            self.put(y, 2, text, attr)
            y += 1
        return y + (1 if header else 0)

    def menu(self, title, items, header=(), footer="↑↓ move · Enter select · Esc back", index=0):
        """items: list of (label, value) or (label, value, disabled_reason). Returns value or None."""
        items = [tuple(i) + ("",) * (3 - len(i)) for i in items]
        index = min(index, max(0, len(items) - 1))
        while True:
            top = self.frame(title, header)
            h, _ = self.scr.getmaxyx()
            rows = max(1, h - top - 2)
            first = max(0, min(index - rows + 1, len(items) - rows)) if index >= rows else 0
            for row, (label, _value, reason) in enumerate(items[first:first + rows]):
                i = first + row
                text = f"{'▸' if i == index else ' '} {label}" + (f"  ({reason})" if reason else "")
                attr = curses.A_REVERSE if i == index else (curses.A_DIM if reason else 0)
                self.put(top + row, 2, text, attr)
            self.put(h - 1, 2, footer, curses.A_DIM)
            self.scr.refresh()
            key = self.scr.getch()
            if key in (curses.KEY_UP, ord("k")):
                index = (index - 1) % len(items)
            elif key in (curses.KEY_DOWN, ord("j")):
                index = (index + 1) % len(items)
            elif key in (10, 13, curses.KEY_ENTER, curses.KEY_RIGHT):
                if not items[index][2]:
                    return items[index][1]
            elif key in (27, ord("q"), curses.KEY_LEFT, curses.KEY_BACKSPACE, 127):
                return None

    def prompt(self, title, question, default=""):
        text = default
        curses.curs_set(1)
        try:
            while True:
                top = self.frame(title)
                self.put(top, 2, question)
                self.put(top + 2, 2, "> " + text)
                self.put(self.scr.getmaxyx()[0] - 1, 2, "Enter accept · Esc cancel", curses.A_DIM)
                self.scr.move(top + 2, min(4 + len(text), self.scr.getmaxyx()[1] - 2))
                self.scr.refresh()
                key = self.scr.get_wch()
                if key in ("\n", "\r", curses.KEY_ENTER):
                    return text
                if key == "\x1b":
                    return None
                if key in (curses.KEY_BACKSPACE, "\x7f", "\b"):
                    text = text[:-1]
                elif isinstance(key, str) and key.isprintable():
                    text += key
        finally:
            curses.curs_set(0)

    def confirm(self, title, lines, yes="Yes", no="Cancel"):
        header = [(line, 0) for line in lines]
        return self.menu(title, [(no, False), (yes, True)], header) is True

    def message(self, title, lines, attr=0):
        top = self.frame(title)
        for i, line in enumerate(lines):
            self.put(top + i, 2, line, attr)
        self.put(self.scr.getmaxyx()[0] - 1, 2, "Press any key", curses.A_DIM)
        self.scr.refresh()
        self.scr.getch()

    def in_terminal(self, title, fn, *args, **kwargs):
        """Leave the menu and run fn with normal terminal output (and password prompts)."""
        curses.def_prog_mode()
        curses.endwin()
        print(f"\n\033[1m{title}\033[0m")
        ok = False
        try:
            result = fn(*args, **kwargs)
            ok = result in (None, 0, True)
        except BackupError as err:
            print(f"\n\033[31mFailed: {err}\033[0m")
        except KeyboardInterrupt:
            print("\n\033[33mCancelled.\033[0m")
        try:
            input("\nPress Enter to return to the menu...")
        except (EOFError, KeyboardInterrupt):
            pass
        curses.reset_prog_mode()
        self.scr.clear()
        self.scr.refresh()
        return ok

    # --- status ---

    def status_lines(self):
        lines = []
        status = read_status(self.dest)
        if status:
            when = status.get("finished", "")[:16].replace("T", " ")
            if status.get("result") == "ok":
                lines.append((f"Last backup:  {when}  ✓", self.good))
            else:
                lines.append((f"Last backup:  FAILED {when}: {status.get('message', '')}", self.bad))
        else:
            lines.append(("Last backup:  never", self.warn))
        stamps = complete_stamps(self.dest / "snapshots")
        try:
            free = shutil.disk_usage(self.dest).free
            lines.append((f"Backups:      {len(stamps)} in {self.dest}  ·  {human_bytes(free)} free", 0))
        except OSError:
            lines.append((f"Backups:      {self.dest} not found", self.warn))
        state = schedule_state()
        sched = f"nightly at {self.cfg['time']}" if state == "on" else state
        lines.append((f"Schedule:     {sched}", self.good if state == "on" else self.warn))
        device, _ = backup_drive(self.dest) if self.dest.exists() else (None, None)
        if device:
            if keyslot_count(device) >= 2:
                lines.append(("Drive password: set", self.good))
            else:
                lines.append(("Drive password: NOT SET (needed to restore if the system drive dies)", self.warn))
        return lines

    # --- screens ---

    def main(self):
        index = 0
        while True:
            have_backups = bool(complete_stamps(self.dest / "snapshots"))
            items = [
                ("Back up now", "backup", "" if self.dest.parent.exists() else "backup drive not found"),
                ("Browse backups", "browse", "" if have_backups else "none yet"),
                ("Restore a file or folder", "files", "" if have_backups else "none yet"),
                ("Restore whole system onto a new drive", "system", "" if have_backups else "none yet"),
                ("Open a backup drive (on a live USB)", "open"),
                ("Schedule", "schedule"),
                ("Set up / repair", "setup"),
                ("Quit", "quit"),
            ]
            choice = self.menu("Main menu", items, self.status_lines(), index=index)
            index = next((i for i, item in enumerate(items) if item[1] == choice), index)
            if choice in (None, "quit"):
                return
            getattr(self, f"screen_{choice}")()

    def screen_backup(self):
        self.in_terminal("Backing up", backup_logged, self.cfg)

    def pick_backup(self, title):
        stamps = complete_stamps(self.dest / "snapshots")
        return self.menu(title, [(stamp_label(s), s) for s in stamps], [("Newest first.", curses.A_DIM)])

    def screen_browse(self):
        stamp = self.pick_backup("Browse backups")
        if not stamp:
            return
        choice = self.menu(stamp_label(stamp), [
            ("Restore a file or folder from it", "files"),
            ("Restore the whole system from it", "system"),
            ("Delete this backup", "delete"),
        ])
        if choice == "files":
            self.screen_files(stamp)
        elif choice == "system":
            self.screen_system(stamp)
        elif choice == "delete" and self.confirm("Delete backup", [f"Delete the backup from {stamp_label(stamp)}?"], yes="Delete"):
            for sub in SUBVOLUMES:
                path = self.dest / "snapshots" / f"{sub}.{stamp}"
                if path.exists():
                    run(["btrfs", "subvolume", "delete", path], check=False)

    def screen_files(self, stamp=None):
        stamp = stamp or self.pick_backup("Restore from which backup?")
        if not stamp:
            return
        sub = self.menu("Where was it?", [
            ("In a home folder (/home)", "@home"),
            ("Elsewhere on the system (/)", "@"),
        ])
        if not sub:
            return
        root = self.dest / "snapshots" / f"{sub}.{stamp}"
        picked = self.browse(root, f"{stamp_label(stamp)}  ·  {SUBVOLUMES[sub]}")
        if not picked:
            return
        original = Path(SUBVOLUMES[sub]) / picked.relative_to(root)
        mode = "copy"
        if original.exists():
            mode = self.menu(f"{original} already exists", [
                ("Keep both: save the backup copy next to it", "copy"),
                ("Replace it with the backup copy", "replace"),
            ])
            if not mode:
                return
        self.in_terminal(f"Restoring {original}", self.restore_and_report, picked, original, mode)

    @staticmethod
    def restore_and_report(source, original, mode):
        target = restore_path(source, original, mode)
        say(f"Restored to {target}")

    def browse(self, root, title):
        """Pick a file or folder under root. Returns its path or None."""
        current = root
        index = 0
        while True:
            try:
                entries = sorted(current.iterdir(), key=lambda p: (not p.is_dir() or p.is_symlink(), p.name.lower()))
            except OSError as err:
                self.message(title, [str(err)], self.bad)
                current = current.parent if current != root else root
                continue
            shown = "/" + str(current.relative_to(root)) if current != root else "/"
            header = [(f"Folder: {shown}", self.accent), ("Enter open · r restore highlighted · ← up · Esc cancel", curses.A_DIM)]
            items = [(p.name + ("/" if p.is_dir() and not p.is_symlink() else ""), p) for p in entries] or [("(empty)", None, "empty")]
            top = self.frame(title, header)
            h, _ = self.scr.getmaxyx()
            rows = max(1, h - top - 1)
            index = min(index, len(items) - 1)
            first = max(0, index - rows + 1)
            for row, item in enumerate(items[first:first + rows]):
                i = first + row
                self.put(top + row, 2, f"{'▸' if i == index else ' '} {item[0]}", curses.A_REVERSE if i == index else 0)
            self.scr.refresh()
            key = self.scr.getch()
            selected = items[index][1]
            if key in (curses.KEY_UP, ord("k")):
                index = (index - 1) % len(items)
            elif key in (curses.KEY_DOWN, ord("j")):
                index = (index + 1) % len(items)
            elif key in (curses.KEY_PPAGE,):
                index = max(0, index - rows)
            elif key in (curses.KEY_NPAGE,):
                index = min(len(items) - 1, index + rows)
            elif key in (10, 13, curses.KEY_ENTER, curses.KEY_RIGHT) and selected:
                if selected.is_dir() and not selected.is_symlink():
                    current, index = selected, 0
                elif key != curses.KEY_RIGHT:
                    return selected
            elif key == ord("r") and selected:
                return selected
            elif key in (curses.KEY_LEFT, curses.KEY_BACKSPACE, 127):
                if current != root:
                    previous = current
                    current = current.parent
                    names = sorted(current.iterdir(), key=lambda p: (not p.is_dir() or p.is_symlink(), p.name.lower()))
                    index = names.index(previous) if previous in names else 0
            elif key in (27, ord("q")):
                return None

    def screen_system(self, stamp=None):
        stamp = stamp or self.pick_backup("Restore which backup?")
        if not stamp:
            return
        disks = candidate_disks(self.dest, self.allow_loop)
        target = self.menu("Restore onto which drive?", [(label, path, reason) for path, label, reason in disks],
                           [("The drive you pick will be ERASED.", self.bad)])
        if not target:
            return
        name = Path(target).name
        typed = self.prompt("Confirm", f"Everything on {target} will be erased. Type {name} to continue:")
        if typed != name:
            return
        self.in_terminal(f"Restoring {stamp_label(stamp)} onto {target}", restore_system, self.dest, stamp, target)

    def screen_open(self):
        data = json.loads(run(["lsblk", "-J", "--tree", "-o", "PATH,SIZE,MODEL,FSTYPE,TYPE,MOUNTPOINTS"]))
        parts = []

        def walk(devs):
            for dev in devs:
                if dev.get("fstype") == "crypto_LUKS" and not dev.get("children"):
                    parts.append((f"{dev['path']}  {dev.get('size', '')}", dev["path"]))
                walk(dev.get("children") or [])

        walk(data.get("blockdevices", []))
        if not parts:
            self.message("Open a backup drive", ["No locked encrypted drives found."])
            return
        device = self.menu("Which drive holds the backups?", parts)
        if device and self.in_terminal(f"Unlocking {device}", self.open_backup_drive, device):
            found = WORK / "backup" / "backups" / "system"
            if (found / "snapshots").is_dir():
                self.cfg["dest"] = str(found)
            else:
                self.message("Open a backup drive", [f"No backups found on {device}."], self.warn)

    def open_backup_drive(self, device):
        name = "omarchy-backup-source"
        run(["cryptsetup", "open", "--readonly", device, name], capture=False)
        (WORK / "backup").mkdir(parents=True, exist_ok=True)
        run(["mount", "-o", "ro", f"/dev/mapper/{name}", WORK / "backup"])
        self.opened_backup = name
        say("Unlocked.")

    def screen_schedule(self):
        state = schedule_state()
        if state == "not installed":
            self.message("Schedule", ["Nightly backups are not installed yet.", "Use Set up / repair → Install first."], self.warn)
            return
        choice = self.menu("Schedule", [
            ("Turn nightly backups off" if state == "on" else "Turn nightly backups on", "toggle"),
            (f"Change time (now {self.cfg['time']})", "time"),
        ], [(f"Nightly backups are {state}.", 0)])
        if choice == "toggle":
            set_schedule(self.cfg, enabled=state != "on")
        elif choice == "time":
            at = self.prompt("Schedule", "Back up every night at (HH:MM, 24-hour):", self.cfg["time"])
            if at and re.fullmatch(r"([01]\d|2[0-3]):[0-5]\d", at):
                set_schedule(self.cfg, at=at)
            elif at is not None:
                self.message("Schedule", [f"{at!r} is not a time like 03:00."], self.warn)

    def screen_setup(self):
        device, key_file = backup_drive(self.dest) if self.dest.exists() or self.dest.parent.exists() else (None, None)
        items = [("Install / update the program and nightly schedule", "install")]
        if device:
            label = "Add a password to the backup drive" if keyslot_count(device) < 2 else "Add another password to the backup drive"
            items.append((label, "password", "" if key_file else "no key file found"))
        items.append((f"Backup location: {self.dest}", "dest"))
        choice = self.menu("Set up / repair", items)
        if choice == "install":
            self.in_terminal("Installing", install, self.cfg)
        elif choice == "password":
            self.in_terminal("Adding a password to the backup drive", self.add_password, device, key_file)
        elif choice == "dest":
            path = self.prompt("Backup location", "Folder for backups (must be on a different btrfs drive):", self.cfg["dest"])
            if path:
                self.cfg["dest"] = path
                save_config(self.cfg)

    @staticmethod
    def add_password(device, key_file):
        say("This lets you unlock the backup drive by typing a password, for example")
        say("from a USB stick after the system drive has failed. Type the new password twice.\n")
        run(["cryptsetup", "luksAddKey", "--key-file", key_file, device], capture=False)
        say("Password added.")

    def close(self):
        if self.opened_backup:
            run(["umount", WORK / "backup"], check=False)
            run(["cryptsetup", "close", self.opened_backup], check=False)


def tui(cfg, allow_loop):
    os.environ.setdefault("ESCDELAY", "25")
    holder = {}

    def start(scr):
        holder["ui"] = UI(scr, cfg, allow_loop)
        holder["ui"].main()

    try:
        curses.wrapper(start)
    finally:
        if "ui" in holder:
            holder["ui"].close()


