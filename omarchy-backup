def ensure_root():
    if os.geteuid() == 0 or os.environ.get("OMARCHY_BACKUP_NO_SUDO"):
        return
    os.execvp("sudo", ["sudo", sys.executable, str(Path(__file__).resolve())] + sys.argv[1:])


def main(argv=None):
    parser = argparse.ArgumentParser(prog=APP, description="Back up and restore an Omarchy system.")
    parser.add_argument("--allow-loop", action="store_true", help=argparse.SUPPRESS)
    sub = parser.add_subparsers(dest="command")
    sub.add_parser("run", help="run one backup now (used by the nightly timer)")
    sub.add_parser("list", help="list backups")
    restore = sub.add_parser("restore-system", help="erase a drive and restore a backup onto it")
    restore.add_argument("--target", required=True)
    restore.add_argument("--backup-dir")
    restore.add_argument("--at", help="backup time, e.g. 20261005T030000 (default: newest)")
    restore.add_argument("--no-efi-register", action="store_true")
    restore.add_argument("--luks-key-file")
    restore.add_argument("--yes", action="store_true")
    args = parser.parse_args(argv)

    ensure_root()
    cfg = load_config()

    if args.command == "run":
        return backup_logged(cfg)
    if args.command == "list":
        for stamp in complete_stamps(Path(cfg["dest"]) / "snapshots"):
            print(f"{stamp}  {stamp_label(stamp)}")
        return 0
    if args.command == "restore-system":
        backup_dir = Path(args.backup_dir or cfg["dest"])
        stamps = complete_stamps(backup_dir / "snapshots")
        stamp = args.at or (stamps[0] if stamps else None)
        if not stamp:
            print(f"No backups in {backup_dir}", file=sys.stderr)
            return 1
        if not args.yes and input(f"Erase {args.target} and restore {stamp}? Type yes: ") != "yes":
            return 1
        try:
            restore_system(backup_dir, stamp, args.target, not args.no_efi_register, args.luks_key_file)
        except BackupError as err:
            print(f"Restore failed: {err}", file=sys.stderr)
            return 1
        return 0

    tui(cfg, args.allow_loop)
    return 0


if __name__ == "__main__":
    sys.exit(main())
